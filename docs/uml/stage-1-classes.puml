@startuml
skinparam dpi 150
skinparam linetype polyline
left to right direction
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
skinparam nodesep 26
skinparam ranksep 42
skinparam padding 3
skinparam shadowing false
skinparam class {
  BorderColor #555555
  ArrowColor #444444
  FontSize 11
}
hide empty members
hide circle

title Restaurant Rush - Stage 1 class diagram (base setting: 18 turns, 2 tables)

class ConsoleUI <<boundary>> #E8F1FA {
  - in: Scanner
  - out: PrintStream
  + showWelcome(seed: int, r: Restaurant): void
  + showTurnStart(turn: int, r: Restaurant): void
  + showTurnEnd(turn: int, r: Restaurant): void
  + showResult(r: Restaurant): void
  + showMessage(message: String): void
  + askWaiterRequest(r: Restaurant): Request
  + askChefRequest(r: Restaurant): Request
  + close(): void
}

class Request <<boundary>> #E8F1FA {
  - action: Action
  - firstTarget: int
  - secondTarget: int
  + {static} idle(): Request
  + {static} seat(customerIndex: int, tableId: int): Request
  + {static} takeOrder(customerIndex: int): Request
  + {static} serve(orderId: int): Request
  + {static} prepare(orderId: int): Request
  + getAction(): Action
  + getFirstTarget(): int
  + getSecondTarget(): int
}

enum Action <<boundary>> #E8F1FA {
  SEAT
  TAKE_ORDER
  SERVE
  PREPARE
  WAIT
}

class TurnEngine <<control>> #FFF4E6 {
  - restaurant: Restaurant
  - ui: ConsoleUI
  - waiter: Waiter
  - chef: Chef
  - cashier: Cashier
  - currentTurn: int
  + TurnEngine(restaurant: Restaurant, ui: ConsoleUI)
  + run(): void
  - runTurn(turn: int): void
  - askWaiter(turn: int): void
  - askChef(turn: int): void
  - applyWaiterRequest(request: Request, turn: int): void
  - applyChefRequest(request: Request, turn: int): void
}

class Waiter <<control>> #FFF4E6 {
  - restaurant: Restaurant
  - actedThisTurn: boolean
  + available(): boolean
  + seat(customer: Customer, table: Table): void
  + takeOrder(customer: Customer, turn: int): Order
  + serve(order: Order, turn: int): void
  + resetForTurn(): void
}

class Chef <<control>> #FFF4E6 {
  - restaurant: Restaurant
  - actedThisTurn: boolean
  + available(): boolean
  + prepare(order: Order, turn: int): void
  + resetForTurn(): void
}

class Cashier <<control>> #FFF4E6 {
  - restaurant: Restaurant
  + collectNext(turn: int): Optional<Customer>
}

class Restaurant <<entity>> #F1F5F1 {
  - config: GameConfig
  - menu: Menu
  - tables: List<Table>
  - waitingQueue: WaitingQueue
  - customers: List<Customer>
  - stats: GameStats
  - random: Random
  - nextCustomerId: int
  - nextOrderId: int
  + Restaurant(config: GameConfig, menu: Menu, random: Random)
  + arrive(turn: int): List<Customer>
  + seat(customer: Customer, table: Table): void
  + takeOrder(customer: Customer, turn: int): Order
  + advanceKitchen(order: Order, turn: int): void
  + serve(order: Order, turn: int): void
  + advanceEating(turn: int): List<Customer>
  + payOldestReady(turn: int): Optional<Customer>
  + applySatisfactionLoss(): List<Customer>
  + isVictory(): boolean
  + waitingCustomers(): List<Customer>
  + seatedCustomers(): List<Customer>
  + customersAwaitingOrder(): List<Customer>
  + servableOrders(): List<Order>
  + preparableOrders(): List<Order>
  + freeTables(): List<Table>
  + getConfig(): GameConfig
  + getMenu(): Menu
  + getTables(): List<Table>
  + getStats(): GameStats
}

class GameConfig <<entity>> #F1F5F1 {
  - maxTurns: int
  - tableCount: int
  - arrivalTurns: List<Integer>
  - targetPaidCustomers: int
  - targetRevenueCents: int
  - targetAverageSatisfaction: double
  + {static} base(): GameConfig
  + isArrivalTurn(turn: int): boolean
}

class Menu <<entity>> #F1F5F1 {
  - items: List<MenuItem>
  + Menu(items: List<MenuItem>)
  + {static} baseMenu(): Menu
  + size(): int
  + itemAt(index: int): MenuItem
  + findByName(name: String): MenuItem
  + items(): List<MenuItem>
}

class MenuItem <<entity>> #F1F5F1 {
  - name: String
  - priceCents: int
  - prepUnits: int
  + MenuItem(name: String, priceCents: int, prepUnits: int)
  + getName(): String
  + getPriceCents(): int
  + getPrepUnits(): int
}

class Table <<entity>> #F1F5F1 {
  - tableId: int
  - occupant: Customer
  + Table(tableId: int)
  + getTableId(): int
  + isFree(): boolean
  + seat(customer: Customer): void
  + vacate(): void
  + getOccupant(): Customer
}

class WaitingQueue <<entity>> #F1F5F1 {
  - customers: Deque<Customer>
  + enqueue(customer: Customer): void
  + remove(customer: Customer): boolean
  + oldest(): Customer
  + contains(customer: Customer): boolean
  + isEmpty(): boolean
  + size(): int
  + snapshot(): List<Customer>
}

class Customer <<entity>> #F1F5F1 {
  - customerId: int
  - name: String
  - satisfaction: int
  - arrivalTurn: int
  - chosenItem: MenuItem
  - order: Order
  - readyToPayTurn: int
  + decideOrder(menu: Menu, random: Random): void
  # chooseMenuItem(menu: Menu, random: Random): MenuItem
  + satisfactionLossPerTurn(): int
  + billCents(item: MenuItem): int
  + placeOrder(order: Order): void
  + loseSatisfaction(points: int): void
  + markReadyToPay(turn: int): void
  + isServed(): boolean
  + hasOrder(): boolean
  + isReadyToPay(): boolean
}

class Order <<entity>> #F1F5F1 {
  - orderId: int
  - customer: Customer
  - item: MenuItem
  - status: OrderStatus
  - unitsDone: int
  - priceCents: int
  - turnPlaced: int
  - turnReady: int
  - turnServed: int
  + Order(orderId: int, customer: Customer, item: MenuItem, priceCents: int, turnPlaced: int)
  + advancePrepUnit(turn: int): void
  - markReady(turn: int): void
  + markServed(turn: int): void
  + markPaid(): void
  + cancel(): void
  + isReady(): boolean
  + isServed(): boolean
  + isActive(): boolean
  + progressText(): String
}

enum OrderStatus <<entity>> #FFF9D6 {
  PLACED
  READY
  SERVED
  PAID
  CANCELLED
}

class GameStats <<entity>> #F1F5F1 {
  - servedCount: int
  - paidCount: int
  - revenueCents: int
  - totalPaidSatisfaction: int
  - unhappyDepartures: int
  + recordServed(): void
  + recordPayment(customer: Customer): void
  + recordDeparture(): void
  + averageSatisfaction(): double
  + hasPaidCustomers(): boolean
}

' ---------------- relationships ----------------
TurnEngine "1" -left-> "1" ConsoleUI : uses
TurnEngine "1" -right-> "1" Restaurant : drives
TurnEngine "1" *-- "1" Waiter : creates
TurnEngine "1" *-- "1" Chef : creates
TurnEngine "1" *-- "1" Cashier : creates
Waiter "1" --> "1" Restaurant
Chef "1" --> "1" Restaurant
Cashier "1" --> "1" Restaurant
ConsoleUI "1" ..> "1" Restaurant : reads state
Request "1" --> "1" Action : action
ConsoleUI "1" ..> "0..*" Request : creates

Restaurant "1" *-- "1" GameConfig
Restaurant "1" *-- "1" Menu
Restaurant "1" *-- "2" Table
Restaurant "1" *-- "1" WaitingQueue
Restaurant "1" *-- "1" GameStats
Restaurant "1" o-- "0..*" Customer : present

Menu "1" o-- "3" MenuItem
Table "1" --> "0..1" Customer : occupant
WaitingQueue "1" o-- "0..*" Customer
Customer "1" -- "0..1" Order : current
Order "*" --> "1" MenuItem
Order "*" --> "1" OrderStatus : status

legend left
  <b>Legend and annotations</b>
  <b>Notation</b>: + public, - private, # protected; <<boundary>> collects and displays,
  <<control>> coordinates, <<entity>> holds game state. Filled diamond =
  composition, hollow diamond = aggregation, dashed arrow = dependency.
  <b>A - Encapsulation</b>: Order.status changes only through advancePrepUnit,
  markServed, markPaid and cancel; illegal calls throw IllegalActionException.
  <b>B - Composition</b> (filled diamond): Restaurant owns its 2 Tables, waiting
  queue, menu, stats and config; TurnEngine owns the three staff roles.
  <b>C - Polymorphism extension point</b>: Customer.satisfactionLossPerTurn() and
  billCents() are overridable. Stage 2 adds VIPCustomer and CriticCustomer; the
  turn controller does not change. Stage 1 has no inheritance yet.
  <b>D - Boundary / control split</b>: ConsoleUI only reads state and collects
  choices; legality is decided in Restaurant, Waiter, Chef and Cashier.
  <b>E - Reproducibility</b>: seeded Random is injected; Customer.decideOrder()
  is the only place a dish is chosen.
  <b>Not drawn</b>: Money.format(cents) and IllegalActionException (a
  RuntimeException) are small supporting types; getters are omitted.
  Entry point restaurant.app.Main wires GameConfig, Menu, Restaurant,
  ConsoleUI and TurnEngine.
endlegend

@enduml
